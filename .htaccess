# ============================================================
# HeroWerk - Apache/.htaccess fuer IONOS Webhosting (statische Site)
# Abgeleitet aus vercel.json (Header / cleanUrls / redirects).
# Stand 2026-06-30. Wirkt NUR auf Apache (IONOS) - Vercel ignoriert diese Datei.
# Validierung: auf IONOS-Staging-Domain per curl (siehe Runbook), VOR dem Cutover.
# ============================================================

Options -Indexes
DirectoryIndex index.html

# ---------- 1. Host/Scheme-Kanonisierung (nur Produktions-Host; Staging unberuehrt) ----------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTP -> HTTPS, nur fuer *.herowerk.de (IONOS-Staging-Systemdomain bleibt unberuehrt)
  RewriteCond %{HTTP_HOST} (^|\.)herowerk\.de$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # apex -> www (kanonisch laut canonical-Tag, sitemap.xml, robots.txt)
  RewriteCond %{HTTP_HOST} ^herowerk\.de$ [NC]
  RewriteRule ^ https://www.herowerk.de%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------- 2. Redirects + cleanUrls (vercel.json: redirects + cleanUrls=true) ----------
<IfModule mod_rewrite.c>
  # /funnel -> /anfrage (permanent, aus vercel.json)
  RewriteRule ^funnel/?$ /anfrage [L,R=301]

  # Sichtbare .html-URL -> saubere URL (301), damit nur die saubere Variante existiert
  RewriteCond %{THE_REQUEST} \s/+([^.\s?]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301]

  # Saubere URL -> intern .html ausliefern (nur wenn Datei existiert)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ---------- 3. Security-Header (1:1 aus vercel.json; vercel-insights inert auf IONOS) ----------
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; form-action 'self' https://api.hsforms.com; connect-src 'self' https://api.hsforms.com https://*.hubspot.com https://*.hsforms.com https://vitals.vercel-insights.com https://script.google.com https://script.googleusercontent.com; img-src 'self' data: https:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://*.vercel-insights.com; frame-src 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set X-Frame-Options "DENY"

  # HSTS - KONSERVATIV fuer die Migration: 1 Jahr, OHNE includeSubDomains/preload.
  # Vercel-Original: max-age=63072000; includeSubDomains; preload (2 J, alle Subdomains).
  # Erst auf das Original umstellen, wenn www + portal + bewerbung gueltiges HTTPS haben
  # (sonst sperrt der Browser jede Subdomain ohne gueltiges Zertifikat fuer bis zu 2 Jahre aus).
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# ---------- 4. Kompression + Caching (Vercel automatisch; Apache braucht es explizit) ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
