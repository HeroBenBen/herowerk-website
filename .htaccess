# ============================================================
# HeroWerk - Apache/.htaccess fuer IONOS Webhosting (statische Site)
# Abgeleitet aus vercel.json (Header / cleanUrls / redirects).
# Stand 2026-06-30. Wirkt NUR auf Apache (IONOS) - Vercel ignoriert diese Datei.
# Validierung: auf IONOS-Staging-Domain per curl (siehe Runbook), VOR dem Cutover.
# ============================================================

Options -Indexes
DirectoryIndex index.html

# Privater Einstieg fuer den Server-Zeitplan. Die PHP-SAPI-Pruefung im Skript
# bleibt als zweite, unabhaengige Sperre bestehen.
<Files "werte-auffrischen.php">
  Require all denied
</Files>

# ---------- 1. Host/Scheme-Kanonisierung (nur Produktions-Host; Staging unberuehrt) ----------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTP -> HTTPS, nur fuer *.herowerk.de (IONOS-Staging-Systemdomain bleibt unberuehrt)
  RewriteCond %{HTTP_HOST} (^|\.)herowerk\.de$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # apex -> www (kanonisch laut canonical-Tag, sitemap.xml, robots.txt)
  RewriteCond %{HTTP_HOST} ^herowerk\.de$ [NC]
  RewriteRule ^ https://www.herowerk.de%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------- 2. Redirects + cleanUrls (vercel.json: redirects + cleanUrls=true) ----------
<IfModule mod_rewrite.c>
  # /funnel -> /anfrage (permanent, aus vercel.json)
  RewriteRule ^funnel/?$ /anfrage [L,R=301]

  # /proklima-hannover -> /foerderung (permanent, GF-Entscheid 25.07.2026)
  # proKlima ist seit dem GF-Entscheid 15.07.2026 aus der Kundenkommunikation
  # genommen (Kanon Abschnitt 6 Punkt 11: KEINE Nennung in der Kundenoberflaeche).
  # Die Seite war danach als Waisenseite live erreichbar und indexierbar; ein
  # blosses noindex haette sie nur unauffindbar gemacht, nicht unerreichbar.
  # Diese Regel steht bewusst VOR der cleanUrls-Kette und faengt beide Formen
  # (mit und ohne .html) in EINEM Sprung, damit keine Redirect-Kette entsteht.
  # Kehrt proKlima zurueck: diese Regel entfernen und die Datei aus archive/
  # zurueckholen. Geloescht wird nichts (R0).
  RewriteRule ^proklima-hannover(\.html)?/?$ /foerderung [L,R=301]

  # --- API: server-seitige Proxys (Rechner + Stellen-Feed) ---
  # /api/rechner und /api/jobs (saubere URLs, ohne .php) -> intern an die jeweilige .php-Datei.
  # MUSS vor der cleanUrls-.html-Regel stehen, damit der /api/-Pfad NICHT als .html-Seite
  # behandelt wird. [L] beendet die Rewrite-Kette fuer diesen Request sofort.
  RewriteRule ^api/rechner/?$ api/rechner.php [L]
  RewriteRule ^api/jobs/?$ api/jobs.php [L]

  # Sichtbare .html-URL -> saubere URL (301), damit nur die saubere Variante existiert.
  # /api/ ist ausgenommen (kein .html dahinter), damit der Proxy-Pfad unberuehrt bleibt.
  RewriteCond %{REQUEST_URI} !^/api/ [NC]
  RewriteCond %{THE_REQUEST} \s/+([^.\s?]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301]

  # Saubere URL -> intern .html ausliefern (nur wenn Datei existiert).
  # /api/ explizit ausnehmen, damit /api/rechner nie nach einer .html-Datei sucht.
  RewriteCond %{REQUEST_URI} !^/api/ [NC]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ---------- 3. Security-Header (1:1 aus vercel.json; vercel-insights inert auf IONOS) ----------
# CSP-Hinweis (Google-Proxys): BEIDE browser-seitigen Google-Aufrufe laufen jetzt server-seitig:
# der Rechner ueber api/rechner.php (/api/rechner) und der Stellen-Feed ueber api/jobs.php
# (/api/jobs). KEIN Browser-Code ruft mehr script.google.com auf. Deshalb sind script.google.com
# UND script.googleusercontent.com aus connect-src ENTFERNT (vorher dort, solange der Jobs-Feed
# noch direkt im Browser lief) und bleiben ENTFERNT. HubSpot/Vercel-Direktiven unveraendert.
#
# CSP-Erweiterung (Consent + Analytics, Opt-in / Consent Mode v2):
#   Nur die Hosts, die consentmanager (CMP), GA4 und Meta-Pixel zwingend brauchen.
#   - consentmanager: script-src cdn.consentmanager.net; connect-src *.consentmanager.net +
#     *.delivery.consentmanager.net; frame-src *.consentmanager.net (Praeferenz-Layer).
#   - GA4 (gtag.js): script-src www.googletagmanager.com; connect-src *.google-analytics.com +
#     region1.google-analytics.com + www.googletagmanager.com.
#   - Meta-Pixel: script-src connect.facebook.net; connect-src www.facebook.com +
#     connect.facebook.net; frame-src www.facebook.com.
#   img-src deckt die Tracking-Pixel bereits ueber 'https:' ab (keine Aenderung noetig).
#   Hinweis: Die Skripte feuern erst NACH Einwilligung (js/consent.js + CMP-Autoblocking) —
#   die CSP erlaubt die Hosts, erzwingt das Laden aber NICHT.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; form-action 'self' https://api.hsforms.com; connect-src 'self' https://api.hsforms.com https://*.hubspot.com https://*.hsforms.com https://vitals.vercel-insights.com https://*.consentmanager.net https://*.delivery.consentmanager.net https://www.googletagmanager.com https://*.google-analytics.com https://region1.google-analytics.com https://connect.facebook.net https://www.facebook.com; img-src 'self' data: https:; font-src 'self'; style-src 'self' 'unsafe-inline' https://cdn.consentmanager.net; script-src 'self' 'unsafe-inline' https://*.vercel-insights.com https://cdn.consentmanager.net https://a.delivery.consentmanager.net https://www.googletagmanager.com https://connect.facebook.net; frame-src https://*.consentmanager.net https://www.facebook.com"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set X-Frame-Options "DENY"

  # HSTS - KONSERVATIV fuer die Migration: 1 Jahr, OHNE includeSubDomains/preload.
  # Vercel-Original: max-age=63072000; includeSubDomains; preload (2 J, alle Subdomains).
  # Erst auf das Original umstellen, wenn www + portal + bewerbung gueltiges HTTPS haben
  # (sonst sperrt der Browser jede Subdomain ohne gueltiges Zertifikat fuer bis zu 2 Jahre aus).
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# ---------- 4. Kompression + Caching (Vercel automatisch; Apache braucht es explizit) ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
  # 2026-07-30: version.json muss für Live-Proben immer den frischen Stand liefern.
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>
