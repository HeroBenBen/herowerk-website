{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "scripts/**/*.js",
    "tests/**/*.js",
    "tests/**/*.d.ts",
    "playwright.config.js"
  ]
}
