{
  "name": "herowerk-website",
  "private": true,
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "test:a11y": "playwright test --grep @a11y",
    "test:smoke": "playwright test --grep @smoke",
    "test:visual": "playwright test --grep @visual",
    "baseline:generate": "node scripts/content-fidelity-check.js --generate",
    "verify:assets": "scripts/version-assets.sh --check",
    "verify:version": "scripts/make-ionos-bundle.sh /tmp/bundle-pruefung && scripts/stamp-version.sh --check /tmp/bundle-pruefung && scripts/stamp-version.sh --selbsttest",
    "verify:consent": "node scripts/consent-integration-check.js",
    "verify:wp-analytics": "node scripts/verify-wp-analytics.mjs",
    "verify:raster": "node scripts/verify-raster.mjs",
    "verify:mobile": "node scripts/verify-mobile.mjs",
    "verify:rechner-snapshot-nachlauf": "node tests/rechner-snapshot-nachlauf.mjs && node tests/rechner-snapshot-zeitplan.mjs",
    "verify:rechner-snapshot-apache": "node scripts/verify-rechner-snapshot-apache.mjs",
    "verify:dimensionierung": "node scripts/sync-dimensionierung-icons.mjs --check && node tests/dimensionierung-sanierung-regression.mjs && node tests/dimensionierung-fassung7-regression.mjs && node tests/rechner-review-blocker-regression.mjs && node tests/geraeteauswahl-regression.mjs && php tests/geraete-katalog-struktur.php",
    "verify:seo": "node scripts/build-structured-data.mjs --check",
    "build:seo": "node scripts/build-structured-data.mjs",
    "build:seo:jobs": "node scripts/build-structured-data.mjs --jobs",
    "build:bausteine": "node scripts/build-bausteine.mjs",
    "verify:bausteine": "node scripts/build-bausteine.mjs --check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.53.2",
    "@sentry/cli": "^2.43.0",
    "@types/node": "^25.9.3",
    "eslint": "^9.29.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  }
}
